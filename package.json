{
  "name": "finfolio",
  "productName": "FinFolio",
  "version": "1.7.0",
  "description": "A stylish, private, offline-first personal finance manager for Windows.",
  "main": "src/main/main.js",
  "author": {
    "name": "Spencer Breland",
    "email": "sbreland@hancockschools.net"
  },
  "license": "MIT",
  "homepage": "https://github.com/Sbreland18/finfolio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sbreland18/finfolio.git"
  },
  "bugs": {
    "url": "https://github.com/Sbreland18/finfolio/issues"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check.js",
    "test": "node scripts/test-core.mjs",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:packaged": "node scripts/e2e-packaged.mjs",
    "test:build-window": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-build-gui.ps1",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "verify": "npm run check && npm test"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-log": "^5.4.0",
    "electron-updater": "^6.8.0"
  }
}
